[alias]
	ca = commit -a -m
	ci = commit
	st = status
	br = branch
	co = checkout
        di = diff
	# pull/push origin's default branch (main or master, whichever the repo uses)
	pom = "!f() { git pull origin \"$(git symbolic-ref --short refs/remotes/origin/HEAD | sed 's@^origin/@@')\" \"$@\"; }; f"
	pum = "!f() { git push origin \"$(git symbolic-ref --short refs/remotes/origin/HEAD | sed 's@^origin/@@')\" \"$@\"; }; f"
	lg = log --graph --pretty=format:'%Cred%h%Creset %C(yellow)%an%d%Creset %s %Cgreen(%cr)%Creset' --date=relative
	lo = log --oneline
        authors = log --pretty=format:'%an <%ae>'
        hist = log --pretty=format:\"%h %ad | %s%d [%an]\" --graph --date=short
        tree = log --graph --pretty=format:'%Cred%h%Creset - %C(blue)%an%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr)%Creset' --abbrev-commit --date=relative
        type = cat-file -t
        dump = cat-file -p
[branch.master]
	mergeoptions = log
[color]
	branch = auto
	diff = auto
	status = auto
	ui = true
[color "branch"]
	current = yellow reverse
	local = yellow
	remote = green
[color "diff"]
	meta = yellow bold
	frag = magenta bold
	old = red bold
	new = green bold
[color "status"]
	added = yellow
	changed = green
[core]
    excludesfile = ~/.gitignore
	autocrlf = false
	safecrlf = true
[diff]
[difftool]
	prompt = false
[diff]
	tool = vimdiff
[merge]
	tool = vimdiff
[user]
	# No global identity: each folder below sets its own, and git refuses
	# to commit anywhere else instead of guessing.
	useConfigOnly = true
[includeIf "gitdir:~/Dev/customertrackr/"]
	path = ~/Dev/redonkulus/dotfiles/.gitconfig-customertrackr
[includeIf "gitdir:~/Dev/redonkulus/"]
	path = ~/Dev/redonkulus/dotfiles/.gitconfig-redonkulus
